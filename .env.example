# Jika diisi, semua request /api/convert wajib mengirim key ini.
SVG2XML_API_KEY=ganti_dengan_key_rahasia_panjang

# Opsional. Pisahkan beberapa origin dengan koma.
# Kosong = izinkan semua origin.
ALLOWED_ORIGINS=https://domain-kamu.vercel.app

# Maksimum SVG mentah yang diterima API dalam byte (default 3000000).
MAX_SVG_BYTES=3000000
