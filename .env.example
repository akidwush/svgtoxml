# Engine API v1 untuk website/app lain.
# Pilihan sederhana: satu API key.
SVG2XML_API_KEY=amx_live_ganti_dengan_key_rahasia_panjang

# Opsional: beberapa key sekaligus. Format: nama=key,nama2=key2
# SVG2XML_API_KEYS=website-a=amx_live_xxx,website-b=amx_live_yyy

# Opsional: batasi browser origin yang boleh memanggil /api/v1/convert.
# Kosong = semua origin boleh selama API key valid.
API_ALLOWED_ORIGINS=https://website-a.vercel.app,https://website-b.com

# Alias lama tetap didukung.
# ALLOWED_ORIGINS=https://website-a.vercel.app

# Maksimum SVG mentah dalam byte. Default 3 MB.
MAX_SVG_BYTES=3000000
